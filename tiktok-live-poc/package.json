{
  "name": "tiktok-live-monitor",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "description": "TikTok Shop live sales monitor",
  "author": "LuxeSense",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.mjs",
    "build:win": "node esbuild.mjs && electron-builder --win",
    "publish": "node esbuild.mjs && electron-builder --publish always",
    "dev": "node esbuild.mjs && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "flv.js": "^1.6.2"
  },
  "build": {
    "appId": "com.sellerfolio.tiktokmonitor",
    "productName": "TikTok Live Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "undefinedmo",
      "repo": "tiktok-live-monitor"
    }
  }
}
