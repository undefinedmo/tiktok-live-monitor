{
  "name": "sellerfolio-live-api",
  "version": "0.1.0",
  "private": true,
  "description": "SellerFolio Live — standalone multi-tenant backend (Postgres + Prisma). Serves the LIVE LEDGER desktop app and the future web UI.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:create": "node scripts/create-database.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:rls": "node scripts/apply-rls.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "fastify": "^5.2.0",
    "pg": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
