{
  "name": "sellerfolio-live-api",
  "version": "0.1.0",
  "private": true,
  "description": "SellerFolio Live — standalone multi-tenant backend (Postgres + Prisma). Serves the LIVE LEDGER desktop app and the future web UI.",
  "type": "module",
  "scripts": {
    "db:create": "node scripts/create-database.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:rls": "node scripts/apply-rls.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
